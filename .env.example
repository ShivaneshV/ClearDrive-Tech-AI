# ClearDrive AI Environment Configuration Example
# Copy this file to .env and insert your API keys

# Nebius Token Factory / NVIDIA Build API Key (starts with nvapi- or Nebius token)
NEBIUS_API_KEY=your_nebius_or_nvidia_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Tavily Real-Time Search API Key for Live Grounding
TAVILY_API_KEY=your_tavily_api_key_here

# Fast Reflex Tier Model (High Throughput ADAS Co-Pilot)
NEMOTRON_NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Deep Causal & Vision-Language Escalation Tier Model (Complex Hazard Analysis)
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional Base URLs (defaults to https://api.tokenfactory.nebius.com/v1/ or https://integrate.api.nvidia.com/v1)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
